(in-package #:mctext)

(defun print-help ()
  (format t "McText ~A~%" "0.1.0")
  (format t "Usage:~%")
  (format t "  mctext                  Open the desktop app~%")
  (format t "  mctext --list           List snippet names~%")
  (format t "  mctext --copy NAME      Copy a snippet to the clipboard~%")
  (format t "  mctext -nw --list       Same as --list~%"))

(defun print-list ()
  (load-store)
  (dolist (group *groups*)
    (format t "~A~%" (mctext-group-name group))
    (dolist (snippet (remove-if-not
                      (lambda (item)
                        (string= (mctext-snippet-group-id item) (mctext-group-id group)))
                      *snippets*))
      (format t "  ~A~%" (mctext-snippet-name snippet)))))

(defun find-snippet-by-name (name)
  (find name *snippets* :key #'mctext-snippet-name :test #'string-equal))

(defun command-line-main (args)
  (cond ((member "--help" args :test #'string=)
         (print-help))
        ((member "--list" args :test #'string=)
         (print-list))
        ((member "--copy" args :test #'string=)
         (load-store)
         (let* ((position (position "--copy" args :test #'string=))
                (name (and position (nth (1+ position) args))))
           (if (and name (find-snippet-by-name name))
               (let ((snippet (find-snippet-by-name name)))
                 (if (copy-to-clipboard (or (mctext-snippet-text snippet) ""))
                     (format t "Copied ~A~%" name)
                     (format t "Clipboard failed~%")))
               (format t "Snippet not found~%"))))
        (t
         (print-help))))

(defun run (&key args)
  (let ((arguments (or args (uiop:command-line-arguments))))
    (if (or (member "-nw" arguments :test #'string=)
            (member "--nw" arguments :test #'string=)
            (member "--no-window" arguments :test #'string=)
            (member "--list" arguments :test #'string=)
            (member "--copy" arguments :test #'string=)
            (member "--help" arguments :test #'string=))
        (command-line-main arguments)
        (progn
          (load-store)
          (gui-main)))))

(defun main (&key args)
  (run :args args))
